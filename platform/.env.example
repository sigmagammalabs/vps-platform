# ---------------------------------------------------------------------------
# Plattform-Einstellungen. scripts/platform.sh legt daraus platform/.env an
# (chmod 600) und traegt TS_FQDN automatisch ein, solange Tailscale laeuft.
# platform/.env gehoert NICHT ins Repository.
# ---------------------------------------------------------------------------

# MagicDNS-Name des VPS im Tailnet, z. B. vps.tail1234.ts.net
# (leer lassen = automatisch aus "tailscale status" ermitteln)
TS_FQDN=

# Zeitzone fuer Zeitplaene (Ofelia) und Anzeige
TZ=Europe/Berlin

# Beszel-Agent: beide Werte zeigt Beszel unter "Add System" an.
# Solange sie leer sind, startet der Agent nicht (docs/betrieb.md -> Monitoring).
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
