# ---------------------------------------------------------------------------
# Arbitrage Scout - Variablen fuer den Portainer-Stack.
#
# In Portainer: Stack -> "Environment variables" -> "Advanced mode" und diesen
# Block (ausgefuellt) einfuegen. Leere Werte sind erlaubt.
# Beim Betrieb ohne Portainer: als stacks/arbitrage-scout/.env ablegen.
# ---------------------------------------------------------------------------

# LLM - mindestens der Key des in config.yaml gewaehlten Providers
GEMINI_API_KEY=
GROQ_API_KEY=

# eBay Browse API (sources.provider: api)
EBAY_APP_ID=
EBAY_CERT_ID=

# Amazon Creators API (nur bei sources.api.purchase_source: amazon)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG=

# Telegram - ohne beide Werte laeuft der Listener nicht (Container bleibt im
# Leerlauf, der taegliche Lauf funktioniert trotzdem)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional -------------------------------------------------------------
# Zeitplan (Cron, 5 Felder, Zeitzone Europe/Berlin)
# SCOUT_SCHEDULE=15 6 * * *
# Eigene Konfiguration statt der im Image (Datei vorher nach
# /srv/apps/arbitrage-scout/config/config.yaml kopieren)
# SCOUT_CONFIG_FILE=/app/userconfig/config.yaml
# Image-Version, z. B. sha-1a2b3c4 fuer ein Rollback
# IMAGE_TAG=latest
# Ressourcengrenzen
# MEM_LIMIT=768m
# CPUS=1.0
# Datenverzeichnis auf dem Host
# DATA_ROOT=/srv/apps/arbitrage-scout
