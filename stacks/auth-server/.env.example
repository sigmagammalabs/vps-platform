# ---------------------------------------------------------------------------
# Konfiguration des Auth-Servers. Auf dem VPS: cp .env.example .env && chmod 600 .env
# Die .env gehoert NIE ins Repository (ist ignoriert).
# ---------------------------------------------------------------------------

# PFLICHT - Passwort fuer das Admin-Dashboard, mindestens 24 Zeichen, zufaellig.
# Der Server startet nicht ohne (oder mit einem bekannten Standardwert).
# Erzeugen:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-40
AUTH_ADMIN_TOKEN=

# Datenpfad auf dem Host (Datenbank + signing_key.pem - beides sichern!)
DATA_ROOT=/srv/apps/auth-server

# Erlaubte Host-Header (kein Geheimnis)
ALLOWED_HOSTS=vps.tail5c3478.ts.net,127.0.0.1,localhost
