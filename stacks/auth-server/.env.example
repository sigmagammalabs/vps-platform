# ---------------------------------------------------------------------------
# Konfiguration für den Auth-Server
# Auf dem VPS kopieren nach .env: cp .env.example .env
# ---------------------------------------------------------------------------

# Geheimes Admin-Passwort für das Web-Dashboard (https://vps.tail5c3478.ts.net:8100/admin)
AUTH_ADMIN_TOKEN=hier-ein-starkes-geheimes-admin-passwort-eintragen

# Geheimes Salt für die Signierung von Offline-Token
AUTH_JWT_SECRET=super-secret-salt-key-sigma-gamma-labs-2026

# Datenpfad auf dem Host
DATA_ROOT=/srv/apps/auth-server

# Erlaubte Host-Header
ALLOWED_HOSTS=vps.tail5c3478.ts.net,127.0.0.1,localhost
