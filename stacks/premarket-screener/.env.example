# ---------------------------------------------------------------------------
# Pre-Market Screener - Variablen fuer den Portainer-Stack.
#
# In Portainer: Stack -> "Environment variables" -> "Advanced mode" und diesen
# Block (ausgefuellt) einfuegen. Leere Werte sind erlaubt.
# Beim Betrieb ohne Portainer: als stacks/premarket-screener/.env ablegen.
# ---------------------------------------------------------------------------

# Telegram (Versand + Listener). Ohne beide Werte: kein Listener, Scan laeuft
# trotzdem (Ergebnis dann nur als CSV in /srv/apps/premarket-screener/watchlist)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq - optional, aktiviert Intent-Parsing und KI-Briefing
GROQ_API_KEY=

# Nur bei --provider alpaca / fmp (derzeit Stubs)
ALPACA_API_KEY=
ALPACA_API_SECRET=
FMP_API_KEY=

# --- Optional -------------------------------------------------------------
# Universum fuer Listener und geplanten Scan: sp500, nasdaq100, dax40, eurostoxx50
# SCREENER_UNIVERSE=eurostoxx50
# Zeitplan (Cron, 5 Felder, Zeitzone Europe/Berlin)
# SCREENER_SCHEDULE=15 8 * * 1-5
# Image-Version, z. B. sha-1a2b3c4 fuer ein Rollback
# IMAGE_TAG=latest
# Ressourcengrenzen
# MEM_LIMIT=1g
# CPUS=1.0
# Datenverzeichnis auf dem Host
# DATA_ROOT=/srv/apps/premarket-screener
